{
  "firestore": {
    "rules": "firestore.rules"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "SwiftStream Fiber Internet",
        "supportEmail": "admin@swiftstream.ph",
        "authorizedRedirectUris": [
          "https://swiftstream-portal.firebaseapp.com/__/auth/handler",
          "http://localhost"
        ]
      }
    }
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
